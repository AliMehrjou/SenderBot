# ============================================================
# .env.example — نمونه‌ی تنظیمات محیطی (کپی کنید: cp .env.example .env)
# ⚠️ فایل .env واقعی در git نادیده گرفته می‌شود و در بسته‌های تحویل نیست؛
#    این نمونه مرجع کامل کلیدهاست.
# ============================================================

# ---------- دیتابیس (MySQL) ----------
DB_USER=root
DB_PASS=password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telegram_bulk_db

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASS=
REDIS_USER=

# ---------- تلگرام ----------
API_ID=0
API_HASH=
BOT_TOKEN=
ADMIN_ID=0

# جوین اجباری «کاربران ربات» (با کاما جدا کنید؛ خالی = غیرفعال)
FORCE_JOIN_CHANNELS=

# 🛡 کانال‌های حفاظت‌شده‌ی ورکرها — ⚠️ خالی بماند (پیش‌فرض):
# کانال‌های قبلی توسط تلگرام حذف شده‌اند و عضویت مشترکِ همه‌ی ورکرها
# ریسک «خوشه‌شدن» و بن زنجیره‌ای دارد. اگر لازم دارید، کانال جدید بسازید.
WORKER_PROTECTED_CHANNELS=

# ---------- سقف‌ها ----------
MAX_TOTAL_ACCOUNTS=50
MAX_DIRECT_ACCOUNTS=50

# 🧊 سقف اکانت روی هر پروکسی — تلگرام اکانت‌های یک IP را یک خوشه می‌بیند.
# مقدار ۲۰/۱۰۰ عامل فاجعه‌ی بن دسته‌ای بود. پیش‌فرض امن: ۳ (ایده‌آل نهایی: ۱).
MAX_ACCOUNTS_PER_PROXY=3

# اجازه‌ی نشستن روی IP خام سرور وقتی پروکسی در دسترس نیست — false بماند!
FALLBACK_TO_DIRECT_IP=false

# دوره‌ی گرم‌شدن اکانت‌های تازه (۲۴ ساعت) — false بماند!
# (اکانت‌های قدیمی بلاک نمی‌شوند؛ فقط لاگین‌های تازه مشمول ۲۴h می‌شوند)
BYPASS_WARMUP=false
MIN_WARMUP_HOURS=24

# ---------- 🛑 گارد ضد بنِ زنجیره‌ای (utils/ban_wave.py) ----------
# پنجره‌ی شمارش موج بن (دقیقه)
BAN_WAVE_WINDOW_MINUTES=60
# آستانه‌ی بن واقعی در پنجره → فریز کل دیسپچر
BAN_WAVE_GLOBAL_THRESHOLD=3
# آستانه‌ی PeerFlood در پنجره → فریز کل دیسپچر
BAN_WAVE_GLOBAL_PF_THRESHOLD=5
# آستانه‌ی «موج فریز» (FROZEN_METHOD_INVALID) → فریز کل دیسپچر
BAN_WAVE_FROZEN_GLOBAL_THRESHOLD=3
# مدت فریز سراسری دیسپچر (دقیقه)
BAN_WAVE_FREEZE_MINUTES=60
# آستانه‌ی بن روی «یک پروکسی» در ۲۴h → قرنطینه‌ی پروکسی
BAN_WAVE_PROXY_BAN_THRESHOLD=2
# آستانه‌ی PeerFlood روی «یک پروکسی» در ۲۴h → قرنطینه‌ی پروکسی
BAN_WAVE_PROXY_PF_THRESHOLD=3
# مدت قرنطینه‌ی پروکسی سوخته (ساعت)
BAN_PROXY_QUARANTINE_HOURS=72
# فاصله‌گذاری claim پروکسی بعد از هر تک‌بن/فریز (ساعت)
BAN_PROXY_CLAIM_COOLDOWN_HOURS=24
# ⚠️ DEPRECATED (v2) — خوانده نمی‌شود؛ فقط برای سازگاری
BAN_FAILOVER_COOLDOWN_MINUTES=30

# ---------- 🧊 گارد فریز (utils/freeze_guard.py) ----------
# طول کول‌داون اکانتِ فریز‌شده (FROZEN_METHOD_INVALID) به ساعت
FROZEN_COOLDOWN_HOURS=24

# ---------- 🖼 چرخش عکس پروفایل (ضد چکش‌کاری) ----------
# چرخش فقط برای پکیج «تازه‌اعمال‌نشده» (false = توصیه‌شده)
PHOTO_ROTATION_ON_STARTUP=false
# بودجه‌ی زمانی کل هر چرخش (ثانیه — 900 = ۱۵ دقیقه)
PHOTO_ROTATION_TIMEOUT_SECONDS=900
# حداکثر دورِ تلاش برای پاک‌سازی عکس‌های قدیمی
PHOTO_WIPE_MAX_PASSES=4

# ---------- استگرت استارت‌آپ ورکرها (ضد همگامی) ----------
WORKER_START_STAGGER_MIN=3
WORKER_START_STAGGER_MAX=8

# ---------- حداقل اقامت اکانت روی یک پروکسی (ضد فلپینگ IP) ----------
PROXY_MIN_DWELL_HOURS=24

# ---------- کش منفی کانال‌های مرده ----------
DEAD_CHANNEL_CACHE_HOURS=24

# ---------- ارسال و سرعت ----------
DAILY_SEND_LIMIT_PER_ACCOUNT=250
HOURLY_SEND_LIMIT_PER_ACCOUNT=15
SEND_DELAY_MIN=1.2
SEND_DELAY_MAX=2.8
ORDER_MAX_CONCURRENT_SENDERS=1
MAX_CONCURRENT_ERRORS=3
COOLDOWN_MINUTES_ON_ERROR=60
SOURCE_FAIL_MAX_WORKERS=3

# ---------- 🚨 بسته‌شدن فوری سفارش در صف دیسپچ (خواسته‌ی کارفرما) ----------
# true (پیش‌فرض): اگر در یک چرخه‌ی دیسپچ هیچ ورکر آماده‌ای سفارش را برندارد
# (همه مشغول / استراحت / لیمیت / گرم‌شدن / عدم تطابق دسته)، سفارش همان لحظه
# و مطابق الگوی «کمبود ورکر» بسته می‌شود: پیام Push به کارفرما + فایل خروجی
# (در صورت وجود ارسال موفق) + داشبورد لایو + اطلاع ادمین‌ها. سفارش دیگر
# هرگز در «در انتظار دیسپچ» نمی‌ماند.
# false: رفتار قبلی (ماندن در صف تا آزاد/گرم شدن ورکر).
INSTANT_CLOSE_ON_NO_WORKER=true

# ---------- پایش اسپم‌بات ----------
PREFLIGHT_SPAMBOT_CHECK_ENABLED=true
PREFLIGHT_SPAMBOT_CACHE_HOURS=4
SPAMBOT_SOFT_LIMIT_REST_MINUTES=60
SPAMBOT_RECHECK_INTERVAL_MINUTES=30

# ---------- رمزنگاری سشن‌ها ----------
# کلید Fernet (۴۴ کاراکتر) — برای تولید: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
